# CtxVault playground — environment variables (all optional).
# Copy to .env.local for local dev, or set in Vercel project settings.
#
# NOTE: these are PLAYGROUND variables. The CtxVault MCP server itself needs no
# model and no key — your coding agent writes the handoff. The playground has no
# agent to borrow, so it needs a model to SIMULATE one (the two chat panes plus
# lib/distill.ts). The vault — save, resume, search, export — works without any
# of this; without a key you just get canned chat replies and a mechanical
# handoff, clearly labelled in the UI.

# --- which model plays the two agents ---------------------------------------
# Format: "<provider>:<model-id>". Providers: anthropic, openai, openrouter,
# compatible. Defaults to anthropic:claude-opus-4-8.
#
#   CTXVAULT_MODEL=anthropic:claude-opus-4-8
#   CTXVAULT_MODEL=openai:gpt-5.1
#   CTXVAULT_MODEL=openrouter:google/gemini-3-pro     # one key, many models
#   CTXVAULT_MODEL=compatible:llama3.1                # any OpenAI-shaped server
CTXVAULT_MODEL=

# Embeddings upgrade search from keyword (BM25, always on) to hybrid. Anthropic
# has no embeddings API, so this is configured separately. Unset by default —
# search works without it; vectors just add recall on paraphrased queries.
#
#   CTXVAULT_EMBED_MODEL=openai:text-embedding-3-small
#   CTXVAULT_EMBED_MODEL=openrouter:openai/text-embedding-3-small
#   CTXVAULT_EMBED_MODEL=compatible:nomic-embed-text
CTXVAULT_EMBED_MODEL=

# --- keys (set the one your chosen provider needs) --------------------------
# Mind the ~$5 budget cap you set on the key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- "compatible" provider only ---------------------------------------------
# Any OpenAI-shaped endpoint: Ollama, Groq, Together, vLLM, LM Studio.
# e.g. http://localhost:11434/v1 for Ollama. The key is often ignored locally.
CTXVAULT_BASE_URL=
CTXVAULT_API_KEY=
